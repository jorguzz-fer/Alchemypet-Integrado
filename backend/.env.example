# === Painel Convênio — Backend (FastAPI) ===

# Porta em que o uvicorn escuta (case com "Ports Exposes" do Coolify = 8000)
PORT=8000

# Banco. Em produção, aponte para o Postgres do Coolify (host = nome do resource):
#   DATABASE_URL=postgresql+psycopg://usuario:senha@postgres:5432/convenio
# Default sqlite permite subir sem banco externo (dev/smoke test):
DATABASE_URL=sqlite:///./dev.db

# CORS: domínios do frontend, separados por vírgula (ou * para liberar tudo)
CORS_ORIGINS=https://alchemypet.tudomudou.com.br

# === Autenticação (JWT) ===
# OBRIGATÓRIO em produção: chave secreta para assinar os tokens.
#   gere com: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
# Validade do token em minutos (padrão 12h)
JWT_EXPIRE_MIN=720
# Admin inicial criado no primeiro startup (troque a senha depois no painel)
ADMIN_EMAIL=admin@alchemypet.com.br
ADMIN_SENHA=CHANGE_ME
ADMIN_NOME=Administrador

ENV=production
